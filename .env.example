# Copy to .env:  cp .env.example .env
# Validated on startup by apps/api/src/config/env.ts. The API refuses to
# start if something here is missing or malformed.

NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Running the API on your machine (npm run dev) against Mongo in Docker:
# directConnection=true is needed because the replica set advertises its
# member as "mongo:27017", a hostname only resolvable inside the Docker network.
MONGO_URL=mongodb://localhost:27017/hr?directConnection=true
REDIS_URL=redis://localhost:6379

# Browser origins allowed to call the API with cookies (comma-separated).
CORS_ORIGIN=http://localhost:5173

# Signs session JWTs. At least 32 characters; use a long random value in production:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=dev-only-insecure-secret-change-me-0123456789
JWT_TTL_SECONDS=28800
