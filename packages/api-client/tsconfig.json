{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Consumed by Vite (a bundler), which resolves extensionless imports like
    // the generated code uses. Unlike the API, this never runs in plain Node.
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": [],
    "noEmit": true
  },
  "include": ["src", "*.ts"]
}
